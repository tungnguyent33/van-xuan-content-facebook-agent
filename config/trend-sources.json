{
  "_ghi_chu": "Cấu hình nguồn thu thập xu hướng cho scripts/fetch-trends.js. Thêm nguồn mới: tạo scripts/sources/<module>.js (xuất buildInput + normalize), rồi thêm 1 phần tử vào 'sources' với module trùng tên file. Bộ từ khóa theo docs/dinh-huong-phat-trien-agent.md mục 3.",
  "defaults": {
    "timeout_seconds": 300
  },
  "keyword_groups": {
